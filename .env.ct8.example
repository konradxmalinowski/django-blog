# Szablon .env dla hostingu CT8 (MyDevil/Small.pl, Passenger).
# Skopiuj jako .env do katalogu projektu na koncie CT8 (przez SSH lub sftp)
# i uzupełnij wartości. python-decouple czyta ten plik automatycznie.
#
# Panel CT8 nie ma osobnego UI na zmienne środowiskowe (jak Render) -
# to jest jedyne miejsce, w którym ustawiasz sekrety na tym hostingu.

DJANGO_SETTINGS_MODULE=devlog.settings.ct8

# Wygeneruj: python3 -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=<wygenerowany-secret-key>

# Domena/subdomena wybrana w panelu CT8 przy dodawaniu strony Python
ALLOWED_HOSTS=<twojlogin>.ct8.pl
SITE_URL=https://<twojlogin>.ct8.pl

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=<twoj@email.pl>
SUPERUSER_PASSWORD=<silne-haslo>

# Opcjonalnie - domyślny obrazek Open Graph dla postów bez cover_image
SITE_DEFAULT_OG_IMAGE=
